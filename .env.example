# ÖRNEK DOSYA - gerçek anahtar İÇERMEZ, git'e gönderilir.
#
# Kullanmak için bu dosyayı ".env" adıyla kopyala ve değerleri doldur.
# PowerShell:
#   Copy-Item .env.example .env
#
# .env dosyası .gitignore içinde olduğu için git'e ASLA gönderilmez.
# Anahtarı bu dosyaya (.env.example) yazma, sadece .env dosyasına yaz.

# Google AI Studio'dan alınan Gemini API anahtarı
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
